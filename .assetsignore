# Files in this directory that must NOT be published as public static assets.
#
# Why this file exists: wrangler.toml sets `pages_build_output_dir = "."`, so
# `wrangler pages deploy .` uploads the ENTIRE repository root. .gitignore does
# not apply to Pages uploads — being untracked by git is not protection.
#
# This was not theoretical. Before this file existed, https://findfilm.ai/.dev.vars
# served the real TMDB_KEY and OMDB_KEY to anyone who asked, byte-identical to the
# local file. Anything added to the repo root is public by default; assume that.
#
# Syntax is .gitignore-style. A bare name matches at any depth, so `.dev.vars`
# also covers spotify-worker/.dev.vars.

# ── Secrets — never publish ────────────────────────────────────────────────
.dev.vars
.dev.vars.*

# ── Local/dev state ────────────────────────────────────────────────────────
.git
.gitignore
.wrangler
.claude
.DS_Store

# ── Server-side source. These are deployed as Workers via their own configs,
#    not served to browsers. sync-worker.js was publicly readable at
#    /sync-worker.js before this file existed. ────────────────────────────────
sync-worker.js
sync-worker.toml
wrangler.toml
spotify-worker
redirect-worker
schema.sql

# ── Internal docs ──────────────────────────────────────────────────────────
CLAUDE.md
HANDOFF.md

# NOTE: `functions/` is deliberately absent. Pages compiles that directory into
# Functions rather than serving it as assets, so it must stay visible to the
# deploy. Verified: /functions/api/[[path]].js is not publicly fetchable.
